# test-keys env (local only). Copy to `.env.test.local` (gitignored, never commit):
#   cp scripts/test-keys.env.example .env.test.local
# Fill in whichever keys you hold — pipes without a key are SKIPPED, not failed.
# Real environment variables win over this file. Model IDs are free text:
# edit them directly when providers retire IDs (they rot in days).

TEST_OPENROUTER_KEY=
TEST_OPENROUTER_MODEL=z-ai/glm-5.3-flash

TEST_GROQ_KEY=
TEST_GROQ_MODEL=qwen/qwen3.8-27b

TEST_DEEPINFRA_KEY=
TEST_DEEPINFRA_MODEL=Qwen/Qwen3-30B-A3B

TEST_TOGETHER_KEY=
TEST_TOGETHER_MODEL=Qwen/Qwen3-30B-A3B

TEST_ALIBABA_KEY=
TEST_ALIBABA_MODEL=qwen3.8-27b

TEST_ZAI_KEY=
TEST_ZAI_MODEL=glm-4.7-flash
