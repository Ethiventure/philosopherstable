# Local dev only. Copy to `.env` (gitignored, never commit) and fill in your key:
#   cp .env.example .env
# Production uses the Netlify dashboard (Site settings → Environment variables),
# NOT this file — Netlify does not read it at build time.
#
# Get a key at https://console.groq.com/keys (free tier, no card).

# Powers the shared "Cabinet shared" provider via `netlify dev`.
GROQ_API_KEY=

# Optional overrides (defaults live in netlify/functions/cabinet.js):
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# SHARED_PER_IP_PER_DAY=60
# SHARED_GLOBAL_PER_DAY=900
